<Window x:Class="NovaBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Browser" Width="1280" Height="820" MinWidth="750" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0C101A"
        Foreground="#E6ECF8" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C2CEE0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#263247"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="43"/>
      <RowDefinition Height="54"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="26"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Background="#101725" LastChildFill="True">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,12,0">
        <TextBlock Text="◈" Foreground="#60E1C2" FontSize="24" VerticalAlignment="Center"/>
        <TextBlock Text=" NOVA" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="NewTabButton" DockPanel.Dock="Right" Content="＋" ToolTip="Nova aba (Ctrl+T)"
              Style="{StaticResource ToolbarButton}" Click="NewTab_Click" Margin="6,0,12,0"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
      </ScrollViewer>
    </DockPanel>
    <Grid Grid.Row="1" Background="#151D2C">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Grid.Column="0" Content="←" ToolTip="Voltar" Style="{StaticResource ToolbarButton}" Click="Back_Click" Margin="8,0,0,0"/>
      <Button x:Name="ForwardButton" Grid.Column="1" Content="→" ToolTip="Avançar" Style="{StaticResource ToolbarButton}" Click="Forward_Click"/>
      <Button Grid.Column="2" Content="↻" ToolTip="Recarregar" Style="{StaticResource ToolbarButton}" Click="Reload_Click"/>
      <Border Grid.Column="3" Margin="6,8" Background="#0B1220" BorderBrush="#2A3B53" BorderThickness="1" CornerRadius="11">
        <DockPanel>
          <TextBlock x:Name="SecurityIndicator" DockPanel.Dock="Left" Text="◈" Foreground="#60E1C2" Margin="13,0,8,0" VerticalAlignment="Center"/>
          <TextBox x:Name="AddressBox" BorderThickness="0" Background="Transparent" Foreground="#F1F5FB"
                   FontSize="14" VerticalContentAlignment="Center" Padding="0,0,10,0" KeyDown="AddressBox_KeyDown"/>
        </DockPanel>
      </Border>
      <Button Grid.Column="4" Content="⌂" ToolTip="Início" Style="{StaticResource ToolbarButton}" Click="Home_Click"/>
      <Button Grid.Column="5" Content="⛨" ToolTip="Proteção Nova (básica)" Foreground="#60E1C2"
              Style="{StaticResource ToolbarButton}" Click="Shield_Click" Margin="0,0,10,0"/>
    </Grid>
    <Grid Grid.Row="2" x:Name="BrowserHost" Background="#0C101A"/>
    <DockPanel Grid.Row="3" Background="#101725">
      <TextBlock x:Name="StatusText" Text="Nova Browser • iniciando" Foreground="#8D9AAF" FontSize="11"
                 VerticalAlignment="Center" Margin="14,0"/>
      <TextBlock Text="Preview • WebView2" Foreground="#65738B" FontSize="11"
                 HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="12,0"/>
    </DockPanel>
  </Grid>
</Window>
