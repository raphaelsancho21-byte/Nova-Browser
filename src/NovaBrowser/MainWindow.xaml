<Window x:Class="NovaBrowser.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nova Browser" Width="1370" Height="850" MinWidth="860" MinHeight="580"
 WindowStartupLocation="CenterScreen" Background="#0B0F16"
 Foreground="#E9EEF8" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#73E8C4"/>
  <Style x:Key="ChromeButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#AEBBD0"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="13,8"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#273247"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".38"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="MaxWidth" Value="190"/>
   <Setter Property="MinWidth" Value="104"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="49"/>
   <RowDefinition Height="62"/>
   <RowDefinition Height="3"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="28"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#111723" BorderBrush="#1D2636" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,15,0">
     <Border Width="28" Height="28" CornerRadius="8" Background="#173C3D">
      <TextBlock Text="✦" Foreground="#73E8C4" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text=" nova" Foreground="White" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="5,0,0,0"/>
     <TextBlock Text=" / browser" Foreground="#77869F" FontSize="12" VerticalAlignment="Center" Margin="3,2,0,0"/>
    </StackPanel>
    <Button DockPanel.Dock="Right" x:Name="NewTabButton" Content="+" ToolTip="Nova aba (Ctrl+T)" Style="{StaticResource ChromeButton}" Click="NewTab_Click" Margin="8,0,15,0" Foreground="#73E8C4"/>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
     <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#141C29" BorderBrush="#1E2A3B" BorderThickness="0,0,0,1">
   <Grid Margin="8,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Button x:Name="BackButton" Grid.Column="0" Content="←" ToolTip="Voltar (Alt+←)" Style="{StaticResource ChromeButton}" Click="Back_Click"/>
    <Button x:Name="ForwardButton" Grid.Column="1" Content="→" ToolTip="Avançar (Alt+→)" Style="{StaticResource ChromeButton}" Click="Forward_Click"/>
    <Button Grid.Column="2" Content="↻" ToolTip="Recarregar (Ctrl+R)" Style="{StaticResource ChromeButton}" Click="Reload_Click"/>
    <Border Grid.Column="3" Margin="9,10,9,10" CornerRadius="12" Background="#0B111C" BorderBrush="#314258" BorderThickness="1">
     <DockPanel>
      <TextBlock x:Name="SecurityIndicator" Text="◇" ToolTip="Informações sobre a conexão" Foreground="#73E8C4" DockPanel.Dock="Left" Margin="15,0,12,0" VerticalAlignment="Center" FontSize="17"/>
      <TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0" Foreground="#E9EEF8" CaretBrush="#73E8C4"
       FontSize="14" VerticalContentAlignment="Center" Padding="0,0,12,0" KeyDown="AddressBox_KeyDown" ToolTip="Pesquise ou digite uma URL — Ctrl+L"/>
     </DockPanel>
    </Border>
    <Button Grid.Column="4" Content="⌂" ToolTip="Página inicial" Style="{StaticResource ChromeButton}" Click="Home_Click"/>
    <Button Grid.Column="5" Content="⛨" ToolTip="Nova Shield" Style="{StaticResource ChromeButton}" Click="Shield_Click" Foreground="#73E8C4"/>
    <Button Grid.Column="6" x:Name="UpdateButton" Content="⋮" ToolTip="Verificar atualizações" Style="{StaticResource ChromeButton}" Click="Update_Click" Margin="0,0,7,0"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" x:Name="LoadProgress" Background="#73E8C4" Visibility="Collapsed" HorizontalAlignment="Left" Width="230"/>
  <Grid Grid.Row="3" x:Name="BrowserHost" Background="#0B0F16"/>
  <Border Grid.Row="4" Background="#101723" BorderBrush="#202B39" BorderThickness="0,1,0,0">
   <DockPanel Margin="12,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <TextBlock x:Name="UpdateStatus" Text="Atualizações automáticas" Foreground="#73E8C4" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <TextBlock Text="NOVA  •  PREVIEW" Foreground="#72839D" FontSize="10" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Text="Nova Browser iniciando…" Foreground="#8B9AB0" FontSize="11" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>